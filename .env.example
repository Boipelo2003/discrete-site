# Copy these NAMES into Vercel > Project > Settings > Environment Variables.
# Never put real keys in this file or in any file in the repo.
PAYSTACK_SECRET_KEY=sk_live_or_sk_test_goes_here
PAYSTACK_WEBHOOK_SECRET=whsec_goes_here_optional
SITE_URL=https://www.yourdomain.co.za
# Your admin login email(s), the same email you use on admin.html. Separate several with commas.
ADMIN_EMAILS=you@example.com

# Optional: order emails (owner alert + customer confirmation) via resend.com
RESEND_API_KEY=re_goes_here
# Must be an address on a domain verified in Resend, or customers will not receive it.
EMAIL_FROM=DISCRETE <orders@yourdomain.co.za>
# Where new-order alerts go. Defaults to the first ADMIN_EMAILS address.
OWNER_EMAIL=you@example.com
